# generated by gen-attach-rules.sh — DO NOT HAND-EDIT (D66 attach spike, doc 14 §4)
# per-session forward isolation anchors: iifname "dstap-<idx>" + own /31 guest IP
# sessions: 3   with-ct: 1
table inet ds_attach_audit {
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		iifname "dstap-0" ip saddr 10.77.0.1 accept comment "s0: only its own guest IP egresses"
		iifname "dstap-1" ip saddr 10.77.1.1 accept comment "s1: only its own guest IP egresses"
		iifname "dstap-2" ip saddr 10.77.2.1 accept comment "s2: only its own guest IP egresses"
		iifname "dstap-*" counter drop comment "any other tap-origin frame: dropped + counted"
	}
}
